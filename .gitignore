# Runtime asset volumes are not in git; the approved release package under
# deploy/brand/2026.1 is tracked and is deployed to the VPS separately.
/public/assets
/public/files
/public/brand

# Large approved fonts are transported as gzip chunks and reconstructed by
# `pnpm brand:assemble` before checks, builds, and local materialization.
/deploy/brand/2026.1/vi-system-2026/deliverables/fonts/NotoSansSC-VF.ttf
/deploy/brand/2026.1/vi-system-2026/deliverables/fonts/NotoSansMonoCJKsc-VF.ttf
/deploy/brand/2026.1/vi-system-2026/manual/output/pdf/CORECOORD-VI-System-2026.1-zh-CN.pdf

