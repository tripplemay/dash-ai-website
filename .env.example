# 生产环境变量示例（复制为 .env 或写入 pm2 ecosystem，切勿提交真实值）
BETTER_AUTH_SECRET=<openssl rand -hex 32>
BETTER_AUTH_URL=https://pr.dashedu.net
DASH_AUTH_DB=/opt/dash-pr/dash-auth.db
# Keep this aligned with deploy/nginx/dash-pr-upstream.conf unless you change both.
PORT=3517
HOSTNAME=127.0.0.1
DASH_PUBLIC_ORIGIN=https://pr.dashedu.net
DASH_HEALTH_URL=https://pr.dashedu.net
NODE_ENV=production

# 仅 scripts/seed.mjs 使用：三个初始账号的初始密码（≥8 位）
SEED_INITIAL_PASSWORD=<强随机密码>
SEED_ADMIN_PASSWORD=<强随机管理员密码>

# 仅本地开发：跳过登录守卫
# DASH_AUTH_DISABLED=1
